    <PackageVersion Include="System.IO.Compression" Version="4.3.0" />
    <PackageVersion Include="System.IO.Compression.ZipFile" Version="4.3.0" />
    <PackageVersion Include="System.Net.Http" Version="4.3.4" />
    <PackageVersion Include="Verify.TUnit" Version="33.7.3" />
    <PackageVersion Include="TUnit" Version="1.87.12" />
    <PackageVersion Include="DiffEngine" Version="21.2.1" />
    <PackageVersion Include="EmptyFiles" Version="8.20.1" />
    <PackageVersion Include="SimpleInfoName" Version="3.2.1" />
    <PackageVersion Include="Verify" Version="33.7.3" />
